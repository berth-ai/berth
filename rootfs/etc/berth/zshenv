# Berth: PATH order for every zsh. Enabled agents (the wrapper layer), the
# base tools moved off the image's pins (berth update) and the pinned base
# toolchain come first and are never shadowed; user-track mise tools come
# next, ahead of the system's own copies (python3, say); ~/.local/bin comes
# last.
typeset -gU path
path=(
  /var/lib/berth/bin
  /opt/agents/tools/current/wrappers
  /opt/mise/wrappers
  ${XDG_DATA_HOME:-$HOME/.local/share}/mise/shims
  $path
  $HOME/.local/bin
)
