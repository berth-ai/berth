# Berth: PATH order for every zsh. Enabled agents (the wrapper layer) and the
# pinned base toolchain come first; user-track mise tools and ~/.local/bin
# come last and never shadow them.
typeset -gU path
path=(
  /var/lib/berth/bin
  /opt/mise/wrappers
  $path
  $HOME/.local/bin
  ${XDG_DATA_HOME:-$HOME/.local/share}/mise/shims
)
