#!/usr/bin/env bash
# berth-mcp-setup: register Berth's enabled MCP servers with every enabled
# agent, and remove the disabled ones. Runs as agent and is idempotent. It
# touches only the entries named playwright and context7. Enabled means the
# agent layer in /var/lib/berth/bin has a wrapper for it; registrations
# point at those wrappers, so a flip needs no re-run.
# jq programs and the JSON literal use $ on purpose; the *_add and *_remove
# functions are called indirectly.
# shellcheck disable=SC2016,SC2329
set -uo pipefail

layer=${BERTH_LAYER_DIR:-/var/lib/berth/bin}

log() { printf 'berth-mcp-setup: %s\n' "$*" >&2; }

# server_argv NAME prints NAME's command line, one word per line, or fails
# when the server is disabled.
server_argv() {
  case $1 in
    playwright) [[ -x $layer/playwright-mcp ]] && printf '%s\n' "$layer/playwright-mcp" --headless --no-sandbox ;;
    context7) [[ -x $layer/context7-mcp ]] && printf '%s\n' "$layer/context7-mcp" ;;
  esac
}

# converge AGENT registers enabled servers and removes disabled ones.
converge() {
  local agent=$1 name rc=0
  local -a argv
  for name in playwright context7; do
    if mapfile -t argv < <(server_argv "$name") && ((${#argv[@]})); then
      "${agent}_add" "$name" "${argv[@]}" || rc=1
    else
      "${agent}_remove" "$name" || rc=1
    fi
  done
  return "$rc"
}

claude_remove() { "$layer/claude" mcp remove --scope user "$1" >/dev/null 2>&1 || true; }
claude_add() {
  local name=$1
  shift
  claude_remove "$name"
  "$layer/claude" mcp add --scope user "$name" -- "$@"
}

codex_remove() { "$layer/codex" mcp remove "$1" >/dev/null 2>&1 || true; }
codex_add() {
  local name=$1
  shift
  codex_remove "$name"
  "$layer/codex" mcp add "$name" -- "$@"
}

opencode_config() {
  local config=${XDG_CONFIG_HOME:-$HOME/.config}/opencode/opencode.json
  mkdir -p "${config%/*}" || return 1
  if [[ ! -f $config ]]; then
    printf '{"$schema": "https://opencode.ai/config.json"}\n' >"$config" || return 1
  fi
  # Edit the real file, so a config symlinked from a dotfiles repo stays a
  # link, and keep its mode (cp -p) rather than mktemp's 0600.
  readlink -f "$config"
}

# opencode_edit JQ_ARGS... rewrites the config with a jq program, atomically.
opencode_edit() {
  local config tmp
  config=$(opencode_config) || return 1
  tmp=$(mktemp "$config.XXXXXX") || return 1
  cp -p "$config" "$tmp" || {
    rm -f "$tmp"
    return 1
  }
  if jq "$@" "$config" >"$tmp" 2>/dev/null; then
    if cmp -s "$tmp" "$config"; then
      rm -f "$tmp"
    else
      mv "$tmp" "$config"
    fi
  else
    rm -f "$tmp"
    log "$config is not plain JSON; leaving it unchanged"
    return 1
  fi
}

opencode_add() {
  local name=$1 command
  shift
  command=$(jq -n '$ARGS.positional' --args -- "$@") || return 1
  opencode_edit --arg name "$name" --argjson cmd "$command" \
    '.mcp[$name] = {type: "local", command: $cmd, enabled: true}'
}

opencode_remove() {
  local config
  config=${XDG_CONFIG_HOME:-$HOME/.config}/opencode/opencode.json
  [[ -f $config ]] || return 0
  opencode_edit --arg name "$1" 'if .mcp then .mcp |= del(.[$name]) else . end'
}

status=0
for agent in claude codex opencode; do
  if [[ ! -x $layer/$agent ]]; then
    log "$agent not enabled; skipping"
    continue
  fi
  if converge "$agent"; then
    log "converged MCP servers for $agent"
  else
    log "failed to converge MCP servers for $agent"
    status=1
  fi
done
exit "$status"
