#!/usr/bin/env bash
# berth-entrypoint: container init, run by tini as root.
#   serve       remap identity, then exec berth supervise
#   berth ...   run the berth CLI as root
#   anything    run as the agent user, as a one-off without supervision
set -euo pipefail
export LC_COLLATE=C

BERTH_LIB_DIR=${BERTH_LIB_DIR:-/usr/local/lib/berth}
# shellcheck source-path=SCRIPTDIR source=../lib/berth/lib.sh
source "$BERTH_LIB_DIR/lib.sh"

# setup_identity remaps agent to PUID/PGID and repairs the home volume's
# ownership. /workspaces is never touched. The ids must differ from
# berth-panel's, or agent would share its access to the broker socket.
setup_identity() {
  local puid=${PUID-1000} pgid=${PGID-1000} var value panel_uid panel_gid
  for var in PUID PGID; do
    value=${!var-1000}
    if ! [[ $value =~ ^[0-9]+$ ]] || ((10#$value == 0)); then
      die "$var must be a non-zero number, got '$value'"
    fi
  done
  panel_uid=$(id -u berth-panel)
  panel_gid=$(id -g berth-panel)
  if ((10#$puid == panel_uid || 10#$pgid == panel_gid)); then
    die "PUID/PGID must differ from the berth-panel user's ids ($panel_uid/$panel_gid)"
  fi
  if [[ $(id -g agent) != "$pgid" ]]; then
    log "setting agent's group id to $pgid"
    groupmod -o -g "$pgid" agent
  fi
  if [[ $(id -u agent) != "$puid" ]]; then
    log "setting agent's user id to $puid"
    usermod -o -u "$puid" agent
  fi
  if [[ $(stat -c '%u:%g' "$BERTH_HOME") != "$puid:$pgid" ]]; then
    log "repairing ownership of $BERTH_HOME"
    chown -R "$puid:$pgid" "$BERTH_HOME"
  fi
}

# check_workspaces warns when agent cannot write to /workspaces, typically a
# host directory Docker created as root. Berth never changes its ownership.
check_workspaces() {
  if ! gosu agent test -w "$BERTH_WORKSPACES"; then
    warn "$BERTH_WORKSPACES is not writable by agent (uid ${PUID:-1000}). Berth never changes its" \
      "ownership; on the host run: chown ${PUID:-1000}:${PGID:-1000} <WORKSPACES_DIR>"
  fi
}

main() {
  setup_identity
  case ${1:-serve} in
    serve) ;;
    berth) exec "$@" ;;
    *) exec gosu agent "$@" ;;
  esac
  check_workspaces
  exec berth supervise
}

main "$@"
