# Optional overrides for compose.yaml. Copy to .env and uncomment what you need.

# Image tag. compose.yaml pins the current release.
# BERTH_VERSION=0.1.0

# Host address the panel is published on. Keep it private: 127.0.0.1, a LAN
# address or a VPN interface, never a public one. Put a reverse proxy with TLS
# in front for anything beyond this machine.
# BIND_ADDRESS=127.0.0.1

# Host port mapped to the panel.
# PANEL_PORT=7690

# Host port mapped to Orca's headless server, used once Orca is switched on
# in Settings. Orca apps on other devices dial BIND_ADDRESS and this port.
# ORCA_PORT=6768

# Runtime identity of the agent user (numeric, non-zero).
# PUID=1000
# PGID=1000

# Host directory mounted at /workspaces. Create it before the first start,
# owned by PUID:PGID; Berth never changes its ownership.
# WORKSPACES_DIR=./workspaces

# Raises GitHub's rate limit for agent update checks.
# GITHUB_TOKEN=
