# Image tag to run. Renovate keeps this current.
# renovate: datasource=docker depName=ghcr.io/salgnt/berth
BERTH_VERSION=0.1.0

# Host address the panel is published on. Use a private address:
# 127.0.0.1, a LAN address or a VPN interface. Never a public one.
BIND_ADDRESS=127.0.0.1

# Host port mapped to the panel.
PANEL_PORT=7690

# Panel login (user:password). Temporary: a later release replaces it with a
# login created in the browser.
PANEL_CREDENTIAL=

# Runtime identity of the agent user (numeric, non-zero).
PUID=1000
PGID=1000

# Host directory mounted at /workspaces. Berth never changes its ownership:
# create it before the first start, owned by PUID:PGID, or Docker creates it
# as root and agent cannot write to it.
WORKSPACES_DIR=./workspaces
